[Unit]
Description=nollama — transparent llama-server manager
Documentation=https://git.hirdforge.com/kit/nollama
After=network.target

[Service]
Type=simple
User=nollama
Group=nollama
ExecStart=/usr/local/bin/nollama serve --config /etc/nollama/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Environment
Environment=NOLLAMA_LLAMA_SERVER=/usr/local/bin/llama-server

# Security hardening (optional — comment out if causing issues)
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/mnt/models /var/log/nollama
# NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nollama

[Install]
WantedBy=multi-user.target
